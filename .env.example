LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=qwen3-coder:480b-cloud
OLLAMA_API_KEY=
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-compatible provider (e.g. an in-cluster LiteLLM proxy). Set LLM_PROVIDER=openai to use it.
OPENAI_BASE_URL=http://litellm.litellm.svc.cluster.local:4000/v1
OPENAI_MODEL=qwen3.6-35b-a3b-coder
OPENAI_API_KEY=

POSTGRES_DB=nba
POSTGRES_USER=nba
POSTGRES_PASSWORD=nba
POSTGRES_PORT=55432
DATABASE_URL=postgresql://nba:nba@localhost:55432/nba
NBA_DB_SCHEMA=bronze
NBA_DB_SCHEMAS=bronze,silver,gold
SQL_RAG_ENABLED=true
SQL_RAG_MAX_EXAMPLES=4

# Port-forwarded cluster source. Use the real user/password/database.
SOURCE_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database
SOURCE_DB_SCHEMA=bronze
